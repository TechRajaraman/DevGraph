:root {
  font-family:
    Inter,
    ui-sans-serif,
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;
  color: #142033;
  background: #f5f7fb;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-width: 320px;
}

a {
  color: inherit;
  text-decoration: none;
}

button,
input,
select {
  font: inherit;
}

.app-shell {
  min-height: 100vh;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  padding: 16px 6vw;
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(14px);
  border-bottom: 1px solid #e5e9f0;
  position: sticky;
  top: 0;
  z-index: 20;
}

.brand {
  display: flex;
  align-items: center;
  gap: 10px;
  font-weight: 850;
  font-size: 1.18rem;
}

.brand-mark {
  display: grid;
  place-items: center;
  width: 34px;
  height: 34px;
  border-radius: 10px;
  background: #142033;
  color: white;
}

.nav {
  display: flex;
  gap: 7px;
  flex-wrap: wrap;
}

.nav a {
  padding: 9px 12px;
  border-radius: 9px;
  color: #687386;
  font-size: 0.9rem;
}

.nav a.active,
.nav a:hover {
  background: #eef1f6;
  color: #142033;
}

.page {
  width: min(1180px, 88vw);
  margin: 0 auto;
  padding: 70px 0;
}

.hero {
  display: grid;
  grid-template-columns: 1.2fr 0.8fr;
  gap: 60px;
  align-items: center;
}

.eyebrow {
  margin: 0 0 10px;
  font-size: 0.72rem;
  font-weight: 850;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: #728096;
}

.hero h1,
.page-heading h1 {
  margin: 0;
  font-size: clamp(2.6rem, 5vw, 5.2rem);
  line-height: 0.96;
  letter-spacing: -0.055em;
}

.hero-copy {
  margin: 22px 0 0;
  max-width: 680px;
  color: #647084;
  line-height: 1.75;
  font-size: 1.05rem;
}

.hero-actions {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
  margin-top: 28px;
}

.button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 0;
  border-radius: 10px;
  padding: 12px 16px;
  font-weight: 800;
  cursor: pointer;
}

.button:disabled {
  opacity: 0.55;
  cursor: not-allowed;
}

.button.primary {
  background: #142033;
  color: #fff;
}

.button.secondary {
  background: #fff;
  border: 1px solid #dfe4ec;
}

.hero-orbit {
  height: 320px;
  border: 1px solid #e2e7ef;
  border-radius: 28px;
  position: relative;
  background:
    radial-gradient(circle, #fff 0 18%, transparent 19%),
    linear-gradient(135deg, #fff, #eef2f7);
  box-shadow: 0 20px 60px rgba(20, 32, 51, 0.08);
}
.hero-orbit span {
  position: absolute;
  padding: 9px 12px;
  border: 1px solid #d9dfe8;
  background: #fff;
  border-radius: 999px;
  font-size: 0.8rem;
  font-weight: 750;
  box-shadow: 0 8px 20px rgba(20, 32, 51, 0.06);
}
.hero-orbit span:nth-child(1) {
  left: 12%;
  top: 23%;
}
.hero-orbit span:nth-child(2) {
  right: 10%;
  top: 25%;
}
.hero-orbit span:nth-child(4) {
  left: 18%;
  bottom: 21%;
}
.hero-orbit span:nth-child(5) {
  right: 15%;
  bottom: 22%;
}
.hero-orbit .orbit-core {
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  padding: 25px;
  border-radius: 50%;
  background: #142033;
  color: #fff;
  border: 0;
}
.stats-grid {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 12px;
  margin: 54px 0;
}
.stat-card,
.panel,
.entity-card,
.developer-card,
.recommendation {
  background: #fff;
  border: 1px solid #e4e8ef;
  border-radius: 16px;
}
.stat-card {
  padding: 20px;
}
.stat-card strong {
  display: block;
  font-size: 1.75rem;
}
.stat-card span {
  color: #788397;
  font-size: 0.85rem;
}
.section-heading,
.page-heading {
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 24px;
  margin-bottom: 22px;
}
.section-heading h2 {
  margin: 0;
}
.section-heading > a {
  font-weight: 800;
  font-size: 0.9rem;
}
.card-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14px;
}
.card-grid.compact {
  grid-template-columns: repeat(3, 1fr);
}
.entity-card,
.developer-card {
  display: flex;
  align-items: flex-start;
  gap: 14px;
  padding: 18px;
  transition:
    0.2s transform,
    0.2s box-shadow;
}
.entity-card:hover,
.developer-card:hover {
  transform: translateY(-2px);
  box-shadow: 0 12px 30px rgba(20, 32, 51, 0.08);
}
.entity-icon,
.avatar {
  flex: none;
  width: 42px;
  height: 42px;
  display: grid;
  place-items: center;
  border-radius: 12px;
  background: #edf1f6;
  font-weight: 900;
}
.entity-card > div:nth-child(2),
.developer-main {
  min-width: 0;
  display: grid;
  gap: 3px;
}
.entity-card strong,
.developer-main strong {
  font-size: 0.96rem;
}
.entity-card span,
.developer-main span,
.developer-main small {
  color: #718095;
  font-size: 0.8rem;
}
.entity-card > b {
  margin-left: auto;
  font-size: 0.72rem;
  color: #718095;
  white-space: nowrap;
}
.entity-card p {
  margin: 8px 0 0;
  color: #718095;
  font-size: 0.78rem;
  line-height: 1.5;
}
.developer-card {
  color: inherit;
}
.avatar {
  background: #142033;
  color: #fff;
  border-radius: 50%;
}
.avatar.large {
  width: 72px;
  height: 72px;
  font-size: 1.25rem;
}
.profile-hero {
  display: flex;
  gap: 20px;
  align-items: center;
  margin-bottom: 34px;
}
.profile-hero h1 {
  margin: 0;
  font-size: clamp(2.5rem, 5vw, 4.2rem);
  letter-spacing: -0.05em;
}
.profile-title {
  margin: 10px 0 0;
  font-weight: 750;
}
.detail-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14px;
  margin-bottom: 14px;
}
.panel {
  padding: 28px;
}
.panel h2 {
  margin: 0 0 10px;
  letter-spacing: -0.025em;
}
.panel h3 {
  margin: 25px 0 10px;
  font-size: 0.85rem;
}
.muted {
  color: #718095;
  line-height: 1.65;
}
.skill-list,
.project-list {
  display: grid;
  gap: 8px;
}
.skill-row {
  display: grid;
  grid-template-columns: 1fr auto auto;
  gap: 12px;
  align-items: center;
  padding: 12px 0;
  border-bottom: 1px solid #eef1f5;
}
.skill-row b {
  font-size: 0.72rem;
}
.skill-row small {
  color: #7a8697;
}
.project-row {
  padding: 14px 0;
  border-bottom: 1px solid #eef1f5;
  display: grid;
  gap: 5px;
}
.project-row span {
  font-size: 0.8rem;
  color: #718095;
}
.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-top: 8px;
}
.chips span {
  padding: 5px 8px;
  border-radius: 999px;
  background: #f0f3f7;
  color: #5f6c7e;
  font-size: 0.7rem;
}
.large-chips span {
  font-size: 0.78rem;
  padding: 7px 10px;
}
.search-wrap {
  margin: 24px 0 24px;
}
.search-wrap input {
  width: 100%;
  padding: 15px 16px;
  border: 1px solid #dce1e9;
  border-radius: 12px;
  background: #fff;
  outline: none;
}
.search-wrap input:focus,
select:focus {
  border-color: #8b97a9;
  box-shadow: 0 0 0 3px #e9edf3;
}
.state-card {
  display: flex;
  align-items: center;
  gap: 12px;
  justify-content: center;
  min-height: 180px;
  padding: 24px;
  border: 1px dashed #ccd3de;
  border-radius: 16px;
  background: #fff;
  color: #718095;
}
.state-card.error-state {
  border-color: #e7caca;
  color: #8a4a4a;
  background: #fffafa;
}
.state-card strong {
  color: #273449;
}
.spinner {
  width: 18px;
  height: 18px;
  border: 2px solid #d7dde7;
  border-top-color: #142033;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}
@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}
.back-link {
  display: inline-block;
  margin-bottom: 24px;
  color: #6b778a;
  font-size: 0.85rem;
  font-weight: 750;
}
.hero-icon {
  width: 76px;
  height: 76px;
  font-size: 1.5rem;
}
.network-graph {
  position: relative;
  height: 340px;
  margin-top: 15px;
  border-radius: 14px;
  background:
    radial-gradient(circle at center, #f8fafc, transparent 55%), #f4f6f9;
  overflow: hidden;
}
.network-graph svg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}
.network-graph line {
  stroke: #b7c0cd;
  stroke-width: 0.35;
}
.network-node {
  position: absolute;
  transform: translate(-50%, -50%);
  display: grid;
  gap: 2px;
  min-width: 80px;
  padding: 10px 12px;
  background: #fff;
  border: 1px solid #dce2ea;
  border-radius: 12px;
  box-shadow: 0 8px 18px rgba(20, 32, 51, 0.06);
  text-align: center;
}
.network-node small {
  font-size: 0.55rem;
  color: #7a8697;
}
.network-node strong {
  font-size: 0.72rem;
}
.network-node.center {
  background: #142033;
  color: #fff;
  border-color: #142033;
}
.network-node.center small {
  color: #aeb8c7;
}
.career-form {
  display: grid;
  grid-template-columns: 1fr auto 1fr auto;
  align-items: end;
  gap: 16px;
  margin: 26px 0;
}
.career-form label {
  display: grid;
  gap: 8px;
  font-size: 0.75rem;
  font-weight: 800;
  color: #667286;
}
.career-form select {
  width: 100%;
  padding: 13px;
  border: 1px solid #dce1e9;
  border-radius: 10px;
  background: #fff;
}
.form-arrow {
  font-size: 1.4rem;
  padding-bottom: 11px;
  color: #8b95a5;
}
.result-panel {
  margin-top: 14px;
}
.path-rail {
  display: flex;
  align-items: center;
  overflow: auto;
  padding: 24px 0 8px;
}
.path-step {
  display: flex;
  align-items: center;
}
.node {
  min-width: 145px;
  padding: 14px;
  border: 1px solid #dce2ea;
  background: #fff;
  border-radius: 14px;
  display: grid;
  gap: 3px;
}
.node span {
  font-size: 0.58rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: #778397;
}
.node strong {
  font-size: 0.85rem;
}
.node small {
  color: #778397;
}
.path-edge {
  min-width: 105px;
  text-align: center;
  display: grid;
  gap: 4px;
}
.path-edge span {
  font-size: 0.55rem;
  font-weight: 800;
  color: #788397;
}
.path-edge i {
  height: 1px;
  background: #aeb7c5;
  position: relative;
}
.path-edge i:after {
  content: "";
  position: absolute;
  right: 0;
  top: -3px;
  border: 3px solid transparent;
  border-right: 0;
  border-left: 5px solid #8e99a8;
}
.recommendation {
  padding: 17px;
  display: grid;
  gap: 5px;
}
.recommendation span,
.recommendation small {
  color: #718095;
  font-size: 0.75rem;
}
.footer {
  padding: 35px 6vw;
  color: #8a95a5;
  font-size: 0.75rem;
  border-top: 1px solid #e5e9f0;
  margin-top: 40px;
}
.mini-network {
  height: 280px;
  margin-top: 28px;
  position: relative;
  border: 1px dashed #cbd3df;
  border-radius: 16px;
  background: #fafbfc;
}
.mini-node {
  position: absolute;
  padding: 10px 14px;
  background: #fff;
  border: 1px solid #d9e0e9;
  border-radius: 999px;
  font-size: 0.75rem;
  font-weight: 800;
  box-shadow: 0 7px 20px rgba(20, 32, 51, 0.06);
}
.mini-node.center {
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  background: #142033;
  color: #fff;
}
.mini-node.n1 {
  left: 15%;
  top: 22%;
}
.mini-node.n2 {
  right: 13%;
  top: 22%;
}
.mini-node.n3 {
  right: 13%;
  bottom: 20%;
}
.mini-node.n4 {
  left: 15%;
  bottom: 20%;
}
@media (max-width: 980px) {
  .hero {
    grid-template-columns: 1fr;
  }
  .stats-grid {
    grid-template-columns: repeat(3, 1fr);
  }
  .card-grid,
  .card-grid.compact,
  .detail-grid {
    grid-template-columns: 1fr 1fr;
  }
  .career-form {
    grid-template-columns: 1fr 1fr;
  }
  .form-arrow {
    display: none;
  }
  .career-form .button {
    grid-column: 1/-1;
  }
}
@media (max-width: 620px) {
  .topbar {
    align-items: flex-start;
    flex-direction: column;
  }
  .nav {
    width: 100%;
    overflow: auto;
  }
  .page {
    padding: 48px 0;
  }
  .stats-grid,
  .card-grid,
  .card-grid.compact,
  .detail-grid {
    grid-template-columns: 1fr;
  }
  .hero h1,
  .page-heading h1 {
    font-size: 3rem;
  }
  .profile-hero {
    align-items: flex-start;
    flex-direction: column;
  }
  .career-form {
    grid-template-columns: 1fr;
  }
  .career-form .button {
    grid-column: auto;
  }
  .path-rail {
    align-items: flex-start;
    flex-direction: column;
  }
  .path-step {
    width: 100%;
    flex-direction: column;
  }
  .path-edge {
    min-height: 65px;
    min-width: 100%;
    transform: rotate(90deg);
  }
}
